# بيانات API - احصل عليها من https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here

# توكن البوت من @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آيدي حسابك الشخصي على تيليجرام (يمكنك معرفته عبر بوت @userinfobot)
# يمكن وضع أكثر من آيدي مفصولة بفاصلة: 111111111,222222222
ADMIN_IDS=111111111

# آيدي قناة التخزين الخاصة (يجب إضافة البوت كأدمن فيها أولًا)
# للحصول عليه: أضف البوت للقناة كأدمن، أرسل أي رسالة بالقناة،
# ثم فوردها لبوت @userinfobot أو @JsonDumpBot ليعطيك آيدي القناة (يبدأ بـ -100)
STORAGE_CHANNEL_ID=-1001234567890

# يوزر البوت بدون @ (يستخدم لبناء الروابط)
BOT_USERNAME=YourBotUsername

DB_PATH=filestore.db
